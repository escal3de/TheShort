[Unit]
Description=TheShort API
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/opt/theshort/publish
ExecStart=/usr/bin/dotnet TheShort.Api.dll
Restart=always
RestartSec=5
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:8080

[Install]
WantedBy=multi-user.target
